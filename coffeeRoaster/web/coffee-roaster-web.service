[Unit]
Description=Coffee roaster web controller
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/coffee-roaster/web/server.py
WorkingDirectory=/opt/coffee-roaster/web
Restart=on-failure
RestartSec=3
# Set User= to your username
#User=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
