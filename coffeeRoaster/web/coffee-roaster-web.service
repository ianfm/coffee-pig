[Unit]
Description=Coffee roaster web controller
After=coffee-roaster.service
Requires=coffee-roaster.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/coffee-roaster/web/server.py
WorkingDirectory=/opt/coffee-roaster/web
Restart=on-failure
RestartSec=3
User=ian
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
