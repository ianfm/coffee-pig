[Unit]
Description=Coffee roaster drum motor daemon
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/coffee-roaster
Restart=on-failure
RestartSec=5
# Set User= to your username (must be in the dialout group)
#User=
Group=dialout
RuntimeDirectory=coffee-roaster
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
